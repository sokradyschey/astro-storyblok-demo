---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
---

<div id="container">
	<main>
		<section class="hero" aria-labelledby="heroTitle">
    <div class="wrap">
      <div>
        <div class="eyebrow"><span class="star"></span>&nbsp; Service-Disabled Veteran-Owned Small Business</div>
        <h1 id="heroTitle">The speed of change requires the <em>talent</em> of people.</h1>
        <p class="lede">Talent solutions for today's changing business imperatives, from the hospital floor to the job site.</p>
        <div class="ctas">
          <a class="btn btn-red" href="#contact">Contact Us</a>
          <a class="btn btn-ghost" href="#why-us">Why Us</a>
        </div>
        <div class="proof">
          <span>Hospitals &amp; health systems</span>
          <span>State Medicaid programs</span>
          <span>VA medical centers</span>
        </div>
      </div>
      <aside class="dossier" aria-label="Service lines">
        <div class="head"><span>Service lines</span><span>Indianapolis, IN</span></div>
        <ol>
          <li class="lead-line"><a href="#healthcare"><span class="k">HC</span><span class="t">Healthcare Workforce Solutions</span><span class="arr">→</span></a></li>
          <li><a href="#workforce"><span class="k">CW</span><span class="t">Consulting &amp; Workforce Solutions</span><span class="arr">→</span></a></li>
          <li><a href="#construction"><span class="k">EC</span><span class="t">Engineering &amp; Construction</span><span class="arr">→</span></a></li>
          <li><a href="#procurement"><span class="k">PS</span><span class="t">Procurement Services</span><span class="arr">→</span></a></li>
        </ol>
      </aside>
    </div>
    <div class="ribbon" aria-hidden="true"></div>
  </section>
	</main>
</div>