
---
import '../styles/global.css';
import Subheader from '../components/Subheader.astro';
import Certs from '../components/Certs.astro';
import Footer from '../components/Footer.astro';
import { useStoryblokApi } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

interface Props {
  title?: string;
}

const { title = 'Bravia Services' } = Astro.props;

const storyblokApi = useStoryblokApi();

const { data } = await storyblokApi.get('cdn/stories/global-header', {
  version: 'draft',
});

const headerStory = data.story;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
	<Subheader />
    <StoryblokComponent blok={headerStory.content} />
	<slot />
	<Certs />
	<Footer />
  </body>
</html>
